---
import { sonVideo } from '../youtube';
import Ikon from './Ikon.astro';

// Sayt qurulanda son video götürülür, sonra brauzerdə yenisi yoxlanılır
const video = await sonVideo();
---

{
  video && (
    <section class="son-video">
      <h2>Son YouTube Videom</h2>
      <a href={video.url} target="_blank" rel="noopener" data-video-id={video.id}>
        <img src={video.sekil} alt="" width="320" height="180" />
        <span class="metn">
          <span class="basliq">{video.basliq}</span>
          <span class="platforma">
            <Ikon url={video.url} />
            YouTube-da izlə ↗
          </span>
        </span>
      </a>
    </section>
  )
}

<script>
  const link = document.querySelector<HTMLAnchorElement>('[data-video-id]');
  if (link) {
    fetch('/api/son-video')
      .then((cavab) => (cavab.ok ? cavab.json() : null))
      .then((video) => {
        if (!video || video.id === link.dataset.videoId) return;
        link.dataset.videoId = video.id;
        link.href = video.url;
        link.querySelector('img')!.src = video.sekil;
        link.querySelector('.basliq')!.textContent = video.basliq;
      })
      .catch(() => {});
  }
</script>

<style>
  a {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: inherit;
    text-decoration: none;
  }

  img {
    width: 160px;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 6px;
    filter: grayscale(60%);
    transition: filter 0.25s;
    flex-shrink: 0;
  }

  a:hover img {
    filter: none;
  }

  .metn {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .basliq {
    color: var(--parlaq);
    line-height: 1.4;
  }

  a:hover .basliq {
    text-decoration: underline;
    text-decoration-color: var(--solgun);
    text-underline-offset: 3px;
  }

  .platforma {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--solgun);
    font-size: 0.85rem;
  }

  @media (max-width: 420px) {
    img {
      width: 120px;
    }
  }
</style>
