---
import { getEntry } from 'astro:content';

interface Props {
  basliq?: string;
  genis?: boolean;
}

const bio = await getEntry('melumat', 'bio');
const ad = bio?.data.ad ?? '';
const { basliq, genis } = Astro.props;
---

<!doctype html>
<html lang="az">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{basliq ? `${basliq} — ${ad}` : ad}</title>
    <meta name="description" content={bio?.data.tesvir ?? ''} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class:list={{ genis }}>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --fon: #111110;
    --metn: #c8c6c2;
    --parlaq: #eeeeec;
    --solgun: #85837e;
    --xett: #2a2a28;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--fon);
    color: var(--metn);
    font-family: 'Literata', Georgia, serif;
    font-size: 17px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  body {
    margin: 0;
    position: relative;
  }

  main {
    max-width: 600px;
    margin: 0 auto;
    padding: 72px 20px 96px;
  }

  /* Ana səhifə: solda mətn, sağda səhnə kartı */
  main.genis {
    max-width: none;
  }

  main.genis .mezmun {
    max-width: 600px;
  }

  @media (min-width: 960px) {
    main.genis {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 64px;
      padding-left: clamp(32px, 6vw, 120px);
      padding-right: clamp(32px, 6vw, 120px);
    }

    main.genis .mezmun {
      flex: 0 1 600px;
    }
  }

  h1,
  h2,
  h3 {
    color: var(--parlaq);
    font-weight: 600;
    line-height: 1.3;
  }

  h1 {
    font-size: 1.6rem;
    margin: 0 0 2rem;
  }

  h2 {
    font-size: 1.15rem;
    margin: 3rem 0 1rem;
  }

  a {
    color: var(--parlaq);
    text-decoration: underline;
    text-decoration-color: var(--solgun);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }

  a:hover {
    text-decoration-color: var(--parlaq);
  }

  ul {
    padding-left: 1.2rem;
  }

  li {
    margin: 0.3rem 0;
  }

  li::marker {
    color: var(--solgun);
  }

  code {
    font-size: 0.9em;
    background: var(--xett);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }

  hr {
    border: 0;
    border-top: 1px solid var(--xett);
  }

  ::selection {
    background: var(--parlaq);
    color: var(--fon);
  }
</style>
